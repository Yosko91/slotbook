datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

// BR-01: one role per user
enum Role {
  STUDENT
  STAFF
}

model User {
  id           Int       @id @default(autoincrement())
  name         String
  email        String    @unique
  passwordHash String
  role         Role
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  sessions     Session[]
  schedules    ScheduleStaff[]
  slots        Slot[]
  bookings     Booking[]
}

// server side session, so logout really deletes it (D-08)
model Session {
  id        String   @id
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([userId])
}

// one subject desk of the center, for example "Calculus I"
model Schedule {
  id          Int             @id @default(autoincrement())
  name        String          @unique
  description String          @default("")
  isActive    Boolean         @default(true)
  staff       ScheduleStaff[]
  slots       Slot[]
}

// BR-04: which tutor manages which schedule
model ScheduleStaff {
  scheduleId Int
  staffId    Int
  schedule   Schedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  staff      User     @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@id([scheduleId, staffId])
}

// times are in UTC (NFR-07). A slot is Booked when it has an ACTIVE booking.
model Slot {
  id         Int      @id @default(autoincrement())
  scheduleId Int
  tutorId    Int
  startsAt   DateTime
  endsAt     DateTime
  createdAt  DateTime @default(now())
  schedule   Schedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  tutor      User     @relation(fields: [tutorId], references: [id], onDelete: Cascade)
  bookings   Booking[]

  @@index([tutorId, startsAt])
  @@index([scheduleId, startsAt])
}

// CANCELLED is used from Sprint 2 (F-04)
enum BookingStatus {
  ACTIVE
  CANCELLED
}

// BR-09: only one ACTIVE booking per slot. This is a partial unique index
// written in SQL in the migration, Prisma schema cannot write it.
model Booking {
  id        Int           @id @default(autoincrement())
  slotId    Int
  studentId Int
  topic     String
  status    BookingStatus @default(ACTIVE)
  createdAt DateTime      @default(now())
  slot      Slot          @relation(fields: [slotId], references: [id], onDelete: Cascade)
  student   User          @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([slotId])
}
